{
  "name": "shelfmark",
  "description": "A private reading log: shelves, progress and yearly goals, with Open Library search and ISBN scan. Your library stays on your device.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/shelfmark.git"
  },
  "scripts": {
    "dev": "pnpm --filter @shelfmark/web dev",
    "build": "pnpm --filter @shelfmark/web build",
    "preview": "pnpm --filter @shelfmark/web preview",
    "typecheck": "pnpm --filter @shelfmark/web exec tsc -b && pnpm --filter @shelfmark/web exec tsc -p ../e2e",
    "test": "pnpm --filter @shelfmark/web test",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c e2e-live/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "playwright": "1.64.1"
  }
}
