{
  "name": "shelfmark",
  "description": "Coming soon — a private reading log: shelves, progress and yearly goals, with Open Library search and ISBN scan. Your library stays on your device.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/shelfmark.git"
  },
  "scripts": {
    "dev": "pnpm --filter @shelfmark/web dev",
    "build": "pnpm --filter @shelfmark/web build",
    "preview": "pnpm --filter @shelfmark/web preview",
    "typecheck": "pnpm --filter @shelfmark/web exec tsc -b",
    "test": "pnpm --filter @shelfmark/web exec tsc -b"
  }
}
